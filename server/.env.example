# ÔNG CHÚ MMO — TikTok Live Bridge (Rust)
# Chép file này thành `.env` rồi sửa theo máy của bạn.

# ─── Máy chủ ──────────────────────────────────────────────────────────────
# Cổng 8085 tránh đụng các cổng dev phổ biến (3000, 5173, 8080).
# Đổi cổng thì phải đổi cả serverUrl trong UnityProject/Assets/Scripts/TikTokWebSocketClient.cs
PORT=8085
HOST=127.0.0.1

# Mở ra mạng LAN. CHỈ bật khi đã có lớp xác thực bên ngoài — bật lên là bất kỳ
# máy nào trong mạng cũng điều khiển được sàn nhảy.
# ALLOW_LAN=1

# ─── Nguồn sự kiện live ───────────────────────────────────────────────────
# tiktok   — nối thẳng TikTok, không cần API key (dùng piratetok-live-rs)
# tikfinity — qua TikFinity Desktop, giữ làm đường lui
LIVE_PROVIDER=tiktok
TIKFINITY_WS_URL=ws://127.0.0.1:21213/

# In từng sự kiện nhận được từ TikTok. Mặc định tắt vì một phiên live đông
# có thể sinh hàng trăm dòng mỗi phút.
# LOG_TIKTOK_EVENTS=1

# ─── Thư mục dữ liệu ──────────────────────────────────────────────────────
# Mặc định là ./config, ./public, ./assets cạnh nơi chạy binary.
# Trong lúc còn chạy song song với bản Node, trỏ assets sang thư mục cũ để
# khỏi nhân đôi ~5MB ảnh GIF. Khi gỡ bỏ TikTokBridge thì chuyển assets/ sang đây.
ASSETS_DIR=../TikTokBridge/assets
# CONFIG_DIR=config
# PUBLIC_DIR=public

# ─── Log ──────────────────────────────────────────────────────────────────
# RUST_LOG=tiktok_bridge=debug
